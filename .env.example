# Required: any OpenAI-compatible chat API
LLM_API_KEY=
LLM_BASE_URL=https://inference.hyde.tech/v1
LLM_MODEL=hyde/glm-5.3-flash
LLAMA_CLOUD_API_KEY=

# Optional: Turso database (otherwise database/invoice_demo.db is used)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: Gmail inbox for emailed invoices (use a Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: comma-separated senders trusted for any vendor
DEMO_TRUSTED_SENDERS=
